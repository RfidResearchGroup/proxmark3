# 手动综合脚本，等价于 proxmark5_fpga.mk 自动生成的步骤。
# 在 fpga 目录下运行：yosys -s pm5/run.ys   （构建时请用 make pm5）

# 1. 读取源代码和宏定义
read_verilog -D PM5 -D WITH_TIMODE -D WITH_HF_15 -D WITH_FELICA_PROBE common/define.v common/mux8.v common/clk_divider.v common/lp20khz_1MSa_iir_filter.v common/min_max_tracker.v common/hi_flite.v common/hi_get_trace.v common/hi_iso14443a.v common/hi_reader.v common/hi_simulate.v common/hi_sniffer.v common/lf_edge_detect.v common/lo_adc.v common/lo_edge_detect.v common/lo_passthru.v common/lo_read.v pm5/gowin_rpll.v pm5/fpga_pm5_hf.v pm5/fpga_pm5_lf.v pm5/fpga_pm5_top.v

# 2. 检查并强制指定顶层
hierarchy -top fpga_top

# 3. 进行综合
synth_gowin -nolutram -json output.json
