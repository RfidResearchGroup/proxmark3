 *-----------------------------------------------------------------------------
 * Common linker script, for os image for sections.
 *-----------------------------------------------------------------------------
 */

SECTIONS
{
    .start : {
        *(.startos)
    } >osimage :text

    .text : {
        *(.text)
        *(.text.*)
        *(.eh_frame)
        *(.glue_7)
        *(.glue_7t)
    } >osimage :text

    .rodata : {
        *(.rodata)
        *(.rodata.*)
        *(fpga_all_bit.data)
        . = ALIGN(8);
    } >osimage :text

    .data : {
        *(.data)
        *(.data.*)
        *(.ramfunc)
        . = ALIGN(4);
    } >ram AT>osimage :data

    __data_src_start__ = LOADADDR(.data);
    __data_start__ = ADDR(.data);
    __data_end__ = __data_start__ + SIZEOF(.data);
    __os_size__ = SIZEOF(.text) + SIZEOF(.data) + SIZEOF(.rodata);

    .bss : {
        __bss_start__ = .;
        *(.bss)
        *(.bss.*)
        . = ALIGN(4);
        __bss_end__ = .;
    } >ram AT>ram :bss

    .commonarea (NOLOAD) : {
        *(.commonarea)
    } >commonarea :NONE
}
