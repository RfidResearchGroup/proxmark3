PHDRS
{
    phase1 PT_LOAD;
    phase2 PT_LOAD;
    phase2data PT_LOAD;
    bss PT_LOAD;
}

ENTRY(flashstart)
SECTIONS
{
    .bootphase1 : {
        *(.startup)

        . = ALIGN(4);
        _version_information_start = .;
        KEEP(*(.version_information));

        . = LENGTH(bootphase1) - 0x4;
        LONG(_version_information_start);
    } >bootphase1 :phase1

    .bootphase2 : {
        KEEP(*(.startphase2))
        *(.text)
        *(.text.*)
        *(.eh_frame)
        *(.glue_7)
        *(.glue_7t)
        *(.rodata)
        *(.rodata.*)
        *(.ramfunc)
        . = ALIGN(4);
    } >ram AT>bootphase2 :phase2

    /* own RW segment, else phase2 is RWX; copied together with .bootphase2 */
    .bootphase2_data : {
        *(.data)
        *(.data.*)
        . = ALIGN(4);
    } >ram AT>bootphase2 :phase2data

    __bootphase2_src_start__ = LOADADDR(.bootphase2);
    __bootphase2_start__ = ADDR(.bootphase2);
    __bootphase2_end__ = ADDR(.bootphase2_data) + SIZEOF(.bootphase2_data);

    ASSERT(ADDR(.bootphase2_data) == __bootphase2_start__ + SIZEOF(.bootphase2), "bootphase2 data not contiguous in RAM")
    ASSERT(LOADADDR(.bootphase2_data) == __bootphase2_src_start__ + SIZEOF(.bootphase2), "bootphase2 data not contiguous in flash")

    .bss : {
        __bss_start__ = .;
        *(.bss)
        *(.bss.*)
        *(COMMON)
        . = ALIGN(4);
        __bss_end__ = .;
    } >ram AT>ram :bss

    ASSERT(__bss_end__ == ADDR(.bss) + SIZEOF(.bss), "BSS boundary excludes globals")

    .commonarea (NOLOAD) : {
        *(.commonarea)
    } >commonarea
}
